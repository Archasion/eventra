# SERVER - packages/config/src/server-schema.ts

# App
NODE_ENV=development
WEB_URL=http://localhost:5173
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://eventra:eventra@localhost:5432/eventra

# Redis
REDIS_URL=redis://localhost:6379

# Typesense
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=development-typesense-key

# Authentication
# Generate with: openssl rand -base64 64
AUTH_SECRET=MXu26/NUXl2uHaJXk5BGC2xiU+9xWMWCnB5d58wYVX0djd9XiuDcu4xkNLQYvSNb8ASnGQ6WzfeWVhmYxLbUKQ==

# Optional OAuth providers.
# If one value in a provider pair is set, both must be set.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe
# Optional for local development unless testing checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend
# Optional unless testing email delivery.
# EMAIL_FROM should be a valid email address according to server validation.
RESEND_API_KEY=
EMAIL_FROM=

# AWS / S3
# Static AWS credentials are optional; prefer the AWS credential provider chain.
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# OpenTelemetry
OTEL_SERVICE_NAME=eventra-api
OTEL_EXPORTER_OTLP_ENDPOINT=

# CLIENT - packages/config/src/client-schema.ts

# App
VITE_API_URL=http://localhost:3000

# Stripe
# Public publishable key; safe for browser use.
VITE_STRIPE_PUBLISHABLE_KEY=
