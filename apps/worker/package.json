    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "ioredis": "^5.7.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}
