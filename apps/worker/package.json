    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "tsx": "^4.23.12",
    "vitest": "^4.1.11"
  }
}
